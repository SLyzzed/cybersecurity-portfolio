---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchivePanel from "../components/ArchivePanel.astro";
---

<BaseLayout title="About" description="About Bradley Ryan and this practical cybersecurity portfolio." currentPath="about">
  <main class="page-shell">
    <ArchivePanel
      label="Professional Profile"
      title="About"
      lede="I currently work in cybersecurity and am developing deeper practical skills in security operations, incident response, detection engineering, digital forensics, security monitoring, and security engineering."
    >
      <div class="prose-block">
        <p>This portfolio documents hands-on work and demonstrates practical capability rather than simply listing certifications or theoretical knowledge.</p>
        <p><a class="text-link" href="https://github.com/SLyzzed" target="_blank" rel="noopener noreferrer">View my GitHub profile</a></p>
      </div>
    </ArchivePanel>
  </main>
</BaseLayout>
