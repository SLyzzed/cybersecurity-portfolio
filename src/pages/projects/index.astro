---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchivePanel from "../../components/ArchivePanel.astro";
import RecordList from "../../components/RecordList.astro";
import { getPublishedEntries } from "../../lib/content";

const projects = (await getPublishedEntries("projects")).map((entry) => ({
  ...entry,
  collection: "projects" as const
}));
---

<BaseLayout title="Projects" description="Cybersecurity project documentation by Slyzzed." currentPath="projects">
  <main class="page-shell">
    <ArchivePanel label="Project Index" title="Projects">
      <RecordList entries={projects} emptyMessage="No published project records are available yet." />
    </ArchivePanel>
  </main>
</BaseLayout>
