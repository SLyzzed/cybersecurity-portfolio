---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchivePanel from "../../components/ArchivePanel.astro";
import { sitePath } from "../../lib/content";
---

<BaseLayout title="Projects" description="Practical cybersecurity projects by Bradley Ryan." currentPath="projects">
  <main class="page-shell">
    <ArchivePanel label="Selected Work" title="Projects" lede="Hands-on security environments built for monitoring, detection, investigation, and repeatable testing.">
      <div class="project-list">
        <article class="project-summary">
          <h2>Home Network Guardian</h2>
          <p>A lightweight Windows tool that helps home users investigate unfamiliar network devices with a privacy-filtered, AI-ready report.</p>
          <p class="technology-list">Windows Batch · PowerShell · Nmap · Npcap</p>
          <a class="text-link" href={sitePath("/projects/home-network-guardian/")}>View Project</a>
        </article>
        <article class="project-summary">
          <h2>Ludus Cyber Range</h2>
          <p>A repeatable range for controlled attack testing, telemetry validation, alert investigation, and incident response practice.</p>
          <p class="technology-list">Ludus · Proxmox · Wazuh · DFIR-IRIS · Atomic Red Team</p>
          <a class="text-link" href={sitePath("/projects/ludus/")}>View Project</a>
        </article>
        <article class="project-summary">
          <h2>API Threat Detector</h2>
          <p>A Python-based API threat detection engine using modular rules to identify SQL injection, command injection and path traversal attempts.</p>
          <p class="technology-list">Python · Pydantic · Rule-based detection</p>
          <a class="text-link" href={sitePath("/projects/api-threat-detector/")}>View Project</a>
        </article>
      </div>
    </ArchivePanel>
  </main>
</BaseLayout>
