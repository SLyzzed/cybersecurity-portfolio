---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/content";
---

<BaseLayout
  title="Slyzzed"
  description="Slyzzed's research notes on incident response, attacker behaviour, defences and preparing for real incidents."
  currentPath="home"
>
  <main class="page-shell">
    <section class="research-hero" aria-labelledby="home-title">
      <div class="research-intro">
        <h1 id="home-title">Slyzzed</h1>
        <p class="lede">My focus is incident response. I work from a simple idea: hope for the best and prepare for the worst.</p>
        <p class="intro-copy">
          I use my lab to understand how attacks work, how defences respond, and what attacker tactics, techniques and procedures (TTPs) look like in the evidence. I want to go into a real incident with a sense of where to start, what evidence to look for, and how to decide what to check next when the situation is unclear.
        </p>
      </div>
      <nav class="research-trail" aria-label="Explore the research">
        <a href={sitePath("/infrastructure/")}>Explore the lab</a>
        <a href={sitePath("/incident-investigations/")}>Follow an investigation</a>
        <a href={sitePath("/blog/")}>Read the reflections</a>
      </nav>
    </section>

    <section class="featured-section" aria-labelledby="current-projects-title">
      <h2 id="current-projects-title">Current Projects</h2>
      <div class="project-list">
        <article class="project-summary">
          <h3>Home Network Guardian</h3>
          <p>A lightweight Windows tool that helps home users investigate unfamiliar network devices with a privacy-filtered, AI-ready report.</p>
          <a class="text-link" href={sitePath("/projects/home-network-guardian/")}>View Project</a>
        </article>
        <article class="project-summary">
          <h3>Ludus Cyber Range</h3>
          <p>A repeatable cyber range used to execute controlled attack techniques and validate endpoint telemetry, detections, and incident response workflows.</p>
          <a class="text-link" href={sitePath("/projects/ludus/")}>View Project</a>
        </article>
        <article class="project-summary">
          <h3>API Threat Detector</h3>
          <p>A Python-based API threat detection engine using modular rules to identify SQL injection, command injection and path traversal attempts.</p>
          <a class="text-link" href={sitePath("/projects/api-threat-detector/")}>View Project</a>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
