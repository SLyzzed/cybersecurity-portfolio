---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchivePanel from "../components/ArchivePanel.astro";
import { sitePath } from "../lib/content";
---

<BaseLayout
  title="Bradley Ryan"
  description="Bradley Ryan's cybersecurity portfolio, focused on security operations, incident response, detection, and practical security engineering."
  currentPath="home"
>
  <main class="page-shell">
    <ArchivePanel
      label="Cybersecurity Portfolio"
      title="Bradley Ryan"
      lede="Cybersecurity professional focused on security operations, incident response, detection, and practical security engineering."
      home
    >
      <p class="intro-copy">
        I build and document hands-on security environments that develop practical capability in
        monitoring, detection, investigation, and incident response.
      </p>

      <section class="featured-section" aria-labelledby="current-projects-title">
        <h2 id="current-projects-title">Current Projects</h2>
        <div class="project-list">
          <article class="project-summary">
            <h3>Ludus Cyber Range</h3>
            <p>A repeatable cyber range used to execute controlled attack techniques and validate endpoint telemetry, detections, and incident response workflows.</p>
            <a class="text-link" href={sitePath("/projects/ludus/")}>View Project</a>
          </article>
        </div>
      </section>
    </ArchivePanel>
  </main>
</BaseLayout>
