---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArchivePanel from "../../../components/ArchivePanel.astro";
import RecordList from "../../../components/RecordList.astro";
import { getBlogCategories, getPublishedBlogPosts, slugifyFilter } from "../../../lib/content";

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();

  return getBlogCategories(posts).map((category) => ({
    params: { category: category.slug },
    props: { category, posts }
  }));
}

const { category, posts } = Astro.props;
const entries = posts
  .filter((post) => slugifyFilter(post.data.category) === category.slug)
  .map((post) => ({ ...post, collection: "blog" as const }));
---

<BaseLayout
  title={`Blog Category: ${category.label}`}
  description={`Published blog posts in the ${category.label} category.`}
  currentPath="blog"
>
  <main class="page-shell">
    <ArchivePanel label="Blog Category" title={category.label}>
      <RecordList entries={entries} emptyMessage="No published blog posts are available in this category." />
    </ArchivePanel>
  </main>
</BaseLayout>
