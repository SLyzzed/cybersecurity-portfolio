---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchivePanel from "../../components/ArchivePanel.astro";
import BlogFilters from "../../components/BlogFilters.astro";
import RecordList from "../../components/RecordList.astro";
import { getBlogCategories, getBlogTags, getPublishedBlogPosts, sitePath } from "../../lib/content";

const posts = (await getPublishedBlogPosts()).map((entry) => ({
  ...entry,
  collection: "blog" as const
}));
const categories = getBlogCategories(posts);
const tags = getBlogTags(posts);
---

<BaseLayout title="Blog" description="Cybersecurity blog posts and research notes." currentPath="blog">
  <main class="page-shell">
    <ArchivePanel label="Blog Index" title="Blog">
      <div class="link-block">
        <a href={sitePath("/rss.xml")}>RSS Feed</a>
      </div>
      <BlogFilters categories={categories} tags={tags} />
      <RecordList entries={posts} emptyMessage="No published blog posts are available yet." />
    </ArchivePanel>
  </main>
</BaseLayout>
