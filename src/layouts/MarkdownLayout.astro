---
import BaseLayout from "./BaseLayout.astro";
import { formatDate, sitePath } from "../lib/content";

interface Props {
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date;
  label: string;
  currentPath: "projects" | "writeups" | "blog";
  tags?: string[];
  authorAlias?: string;
  category?: string;
  readingTime?: number;
  coverImage?: string;
}

const {
  title,
  description,
  date,
  updatedDate,
  label,
  currentPath,
  tags = [],
  authorAlias,
  category,
  readingTime,
  coverImage
} = Astro.props;
const coverImageSrc =
  coverImage && (/^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(coverImage) ? coverImage : sitePath(coverImage));
---

<BaseLayout title={title} description={description} currentPath={currentPath}>
  <main class="page-shell">
    <article class="archive-panel markdown-page">
      <p class="record-label">{label}</p>
      <div class="markdown-content">
        <h1>{title}</h1>
        <p class="meta">
          {formatDate(date)}
          {updatedDate && ` / Updated ${formatDate(updatedDate)}`}
          {readingTime && ` / ${readingTime} min read`}
        </p>
        {authorAlias && <p class="meta">By {authorAlias}</p>}
        {category && <p class="meta">{category}</p>}
        {tags.length > 0 && <p class="meta">{tags.join(" / ")}</p>}
        {coverImageSrc && <img src={coverImageSrc} alt="" class="cover-image" />}
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
