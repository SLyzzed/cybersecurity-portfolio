---
interface Props {
  label: string;
  title: string;
  lede?: string;
  home?: boolean;
}

const { label, title, lede, home = false } = Astro.props;
const titleId = `${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-title`;
---

<section class:list={["archive-panel", home && "home-panel"]} aria-labelledby={titleId}>
  <p class="record-label">{label}</p>
  <h1 id={titleId}>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</section>
