---
import { getEntryUrl } from "../lib/content";

interface Post {
  id: string;
  data: {
    title: string;
  };
}

interface Props {
  previous?: Post;
  next?: Post;
}

const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav class="post-nav" aria-label="Post navigation">
    {previous && (
      <a href={getEntryUrl("blog", previous.id)}>
        <span class="meta">Previous</span>
        {previous.data.title}
      </a>
    )}
    {next && (
      <a href={getEntryUrl("blog", next.id)}>
        <span class="meta">Next</span>
        {next.data.title}
      </a>
    )}
  </nav>
)}
